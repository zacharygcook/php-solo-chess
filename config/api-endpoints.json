{
  "endpoints": [
    {
      "path": "/backend/public/api/session.php",
      "method": "get",
      "summary": "Load or create the current game session",
      "success_status": 200
    },
    {
      "path": "/backend/public/api/auth/register.php",
      "method": "post",
      "summary": "Register a local user and authenticate the session",
      "success_status": 201,
      "request_schema": "AuthRegisterRequest",
      "response_schema": "AuthResponse"
    },
    {
      "path": "/backend/public/api/auth/login.php",
      "method": "post",
      "summary": "Authenticate the session as an existing local user",
      "success_status": 200,
      "request_schema": "AuthLoginRequest",
      "response_schema": "AuthResponse"
    },
    {
      "path": "/backend/public/api/auth/logout.php",
      "method": "post",
      "summary": "Clear the authenticated user from the current session",
      "success_status": 200,
      "response_schema": "AuthResponse"
    },
    {
      "path": "/backend/public/api/auth/user.php",
      "method": "get",
      "summary": "Load the authenticated user for the current session",
      "success_status": 200,
      "response_schema": "AuthResponse"
    },
    {
      "path": "/backend/public/api/move.php",
      "method": "post",
      "summary": "Submit one move for the active player",
      "success_status": 200,
      "request_schema": "MoveRequest"
    },
    {
      "path": "/backend/public/api/games/new.php",
      "method": "post",
      "summary": "Create a new untimed, preset, or custom timed game",
      "success_status": 201,
      "request_schema": "CreateGameRequest"
    },
    {
      "path": "/backend/public/api/games/move.php",
      "method": "post",
      "summary": "Submit one move for the active player through the games API",
      "success_status": 200,
      "request_schema": "MoveRequest"
    },
    {
      "path": "/backend/public/api/games/resign.php",
      "method": "post",
      "summary": "Resign the active game for one side",
      "success_status": 200,
      "request_schema": "GameActionRequest"
    },
    {
      "path": "/backend/public/api/games/draw-offer.php",
      "method": "post",
      "summary": "Offer a draw for the side to move",
      "success_status": 200,
      "request_schema": "GameActionRequest"
    },
    {
      "path": "/backend/public/api/games/draw-accept.php",
      "method": "post",
      "summary": "Accept an available draw offer as the opponent",
      "success_status": 200,
      "request_schema": "GameActionRequest"
    },
    {
      "path": "/backend/public/api/games/draw-claim.php",
      "method": "post",
      "summary": "Claim an available rule-owned draw",
      "success_status": 200,
      "request_schema": "DrawClaimRequest"
    },
    {
      "path": "/backend/public/api/games/abandon.php",
      "method": "post",
      "summary": "Abandon the active game without a winner",
      "success_status": 200,
      "request_schema": "GameActionRequest"
    },
    {
      "path": "/backend/public/api/games/history.php",
      "method": "get",
      "summary": "List saved games for the authenticated owner",
      "success_status": 200,
      "response_schema": "GameHistoryResponse"
    },
    {
      "path": "/backend/public/api/games/open.php",
      "method": "get",
      "summary": "Open one saved game owned by the authenticated user",
      "success_status": 200,
      "response_schema": "SavedGameResponse"
    },
    {
      "path": "/backend/public/api/games/replay.php",
      "method": "get",
      "summary": "Load read-only replay data for one saved game owned by the authenticated user",
      "success_status": 200,
      "response_schema": "ReplayResponse"
    },
    {
      "path": "/backend/public/api/games/export.php",
      "method": "get",
      "summary": "Download PGN for the active game or one saved game owned by the authenticated user",
      "success_status": 200,
      "response_content_type": "application/x-chess-pgn; charset=UTF-8",
      "response_schema": "PgnDownload"
    },
    {
      "path": "/backend/public/api/reset.php",
      "method": "post",
      "summary": "Reset the current session to the initial position",
      "success_status": 200
    },
    {
      "path": "/backend/public/api/setup.php",
      "method": "post",
      "summary": "Request loading a position from FEN (currently a placeholder)",
      "success_status": 202,
      "request_schema": "FenRequest"
    }
  ]
}
